{
  "name": "grocery-list",
  "version": "1.0.0",
  "description": "app to follow your grocery list",
  "main": "index.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "test": "./node_modules/.bin/dotenvx run --overload --env-file=.env.development -e NODE_ENV=test -- jest --runInBand",
    "start": "./node_modules/.bin/dotenvx run --env-file=.env.production -- node index.js",
    "dev": "./node_modules/.bin/dotenvx run --env-file=.env.development -- node --watch index.js",
    "migrate": "./node_modules/.bin/dotenvx run --env-file=.env.development -- node scripts/migrate.js",
    "migrate:test": "./node_modules/.bin/dotenvx run --overload --env-file=.env.development -e NODE_ENV=test -- node scripts/migrate.js",
    "migrate:prod": "./node_modules/.bin/dotenvx run --env-file=.env.production -- node scripts/migrate.js",
    "lint": "eslint ."
  },
  "author": "Virginie Lemaire",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.57.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pg": "^8.7.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "__tests__/settings/"
    ],
    "setupFilesAfterEnv": [
      "./__tests__/settings/setup.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jest": "^29.6.2",
    "supertest": "^7.2.2"
  }
}
